<idea-plugin>
    <id>com.danilian.speakide</id>
    <name>SpeakIDE</name>
    <vendor email="daniliandaniil@gmail.com"
            url="https://github.com/Dragonav4">Dragonav
    </vendor>
    <description><![CDATA[
        Universal voice input for IntelliJ IDEA.<br/>
        Dictate into AI Chat, Junie, code editor, commit messages — any text field.<br/>
        Supports OpenAI Whisper (cloud) and Vosk (offline).
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <!-- Settings page: Settings > Tools > SpeakIDE -->
        <applicationConfigurable
            parentId="tools"
            instance="com.danilian.speakide.settings.SpeakIdeSettingsConfigurable"
            id="com.danilian.speakide.settings"
            displayName="SpeakIDE"/>

        <!-- Non-secret persistent settings (API key lives in PasswordSafe) -->
        <applicationService
            serviceImplementation="com.danilian.speakide.settings.SpeakIdeSettings"/>

        <!-- Status-bar widget: microphone icon reflects recording state -->
        <statusBarWidgetFactory
            id="com.danilian.speakide.StatusBarWidget"
            implementation="com.danilian.speakide.ui.SpeakIdeStatusBarWidgetFactory"
            order="after encodingWidget"/>

        <!-- Notification group for all SpeakIDE balloons -->
        <notificationGroup id="SpeakIDE" displayType="BALLOON"/>
    </extensions>

    <actions>
        <action id="com.danilian.speakide.ToggleRecording"
                class="com.danilian.speakide.action.ToggleRecordingAction"
                text="SpeakIDE: Toggle Voice Recording"
                description="Start or stop voice recording; transcribed text is inserted at the cursor"
                icon="/icons/microphone.svg">
            <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt M"/>
            <add-to-group group-id="ToolsMenu" anchor="last"/>
            <add-to-group group-id="NavBarToolBar" anchor="last"/>
        </action>
    </actions>

</idea-plugin>
